generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AuthUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("auth_users")
}

model Perfil {
  id                    String                  @id @db.Uuid
  nombreCompleto        String                  @map("nombre_completo") @db.VarChar(150)
  telefono              String?                 @db.VarChar(20)
  avatarUrl             String?                 @map("avatar_url")
  municipioId           Int                     @map("municipio_id")
  verificado            Boolean                 @default(false)
  createdAt             DateTime?               @default(now()) @map("created_at") @db.Timestamp(6)
  acreditaciones_mesa   acreditaciones_mesa[]
  encuentros            encuentros[]
  equipos               equipos[]
  organizacion_miembros          organizacion_miembros[]
  organizaciones                 organizaciones[]
  solicitudes_vinculacion_atleta solicitudes_vinculacion_atleta[]
  municipio                      Municipio               @relation(fields: [municipioId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("perfiles")
}

model Departamento {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique @db.VarChar(50)
  createdAt  DateTime?   @default(now()) @map("created_at") @db.Timestamp(6)
  municipios Municipio[]

  @@map("departamentos")
}

model Municipio {
  id             Int              @id @default(autoincrement())
  departamentoId Int              @map("departamento_id")
  nombre         String           @db.VarChar(50)
  createdAt      DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)
  comunidades    comunidades[]
  departamento   Departamento     @relation(fields: [departamentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizaciones organizaciones[]
  perfiles       Perfil[]
  equipos        equipos[]

  @@map("municipios")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
